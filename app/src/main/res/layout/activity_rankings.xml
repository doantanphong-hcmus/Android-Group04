<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rankings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rankings_background"
    tools:ignore="Overdraw">

    <FrameLayout
        android:id="@+id/rankings_header"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/rankings_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/rankings_back_content_description"
            android:padding="12dp"
            android:src="@drawable/ic_library_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="@string/rankings_title"
            android:textColor="@color/rankings_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rankings_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_rankings_segment_container"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/rankings_period_day"
                    style="@style/RankingsSegmentOption"
                    android:text="@string/rankings_period_day" />

                <TextView
                    android:id="@+id/rankings_period_week"
                    style="@style/RankingsSegmentOption"
                    android:text="@string/rankings_period_week" />

                <TextView
                    android:id="@+id/rankings_period_month"
                    style="@style/RankingsSegmentOption"
                    android:text="@string/rankings_period_month" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rankings_segment_container"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/rankings_metric_read"
                    style="@style/RankingsSegmentOption"
                    android:text="@string/rankings_metric_read" />

                <TextView
                    android:id="@+id/rankings_metric_listen"
                    style="@style/RankingsSegmentOption"
                    android:text="@string/rankings_metric_listen" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rankings_entries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
