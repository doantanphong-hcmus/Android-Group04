<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rankings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rankings_background"
    tools:ignore="Overdraw">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/rankings_bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/rankings_title"
                android:textColor="@color/rankings_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_rankings_segment_container"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/rankings_period_day"
                    style="@style/RankingsSegmentOption"
                    android:text="@string/rankings_period_day" />

                <TextView
                    android:id="@+id/rankings_period_week"
                    style="@style/RankingsSegmentOption"
                    android:text="@string/rankings_period_week" />

                <TextView
                    android:id="@+id/rankings_period_month"
                    style="@style/RankingsSegmentOption"
                    android:text="@string/rankings_period_month" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rankings_segment_container"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/rankings_metric_read"
                    style="@style/RankingsSegmentOption"
                    android:text="@string/rankings_metric_read" />

                <TextView
                    android:id="@+id/rankings_metric_listen"
                    style="@style/RankingsSegmentOption"
                    android:text="@string/rankings_metric_listen" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rankings_entries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/rankings_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/navigation_background"
        android:elevation="@dimen/navigation_elevation"
        app:itemActiveIndicatorStyle="@null"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconTint="@color/navigation_item_color"
        app:itemTextColor="@color/navigation_item_color"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_rankings_bottom_navigation" />

</androidx.constraintlayout.widget.ConstraintLayout>
