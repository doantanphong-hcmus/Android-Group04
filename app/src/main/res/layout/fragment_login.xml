<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature.auth.LoginFragment">

    <include
        layout="@layout/view_auth_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/login_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="640dp">

            <LinearLayout
                android:id="@+id/login_form"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.56"
                app:layout_constraintWidth_max="@dimen/auth_form_max_width">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/email_input"
                    style="@style/Widget.Material3.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="@color/auth_field_background"
                    app:boxCornerRadiusBottomEnd="@dimen/auth_field_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/auth_field_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/auth_field_corner_radius"
                    app:boxCornerRadiusTopStart="@dimen/auth_field_corner_radius"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconMinSize="36dp"
                    app:startIconTint="@color/auth_text_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/auth_field_height"
                        android:fontFamily="serif"
                        android:gravity="center_vertical"
                        android:hint="@string/login_email_hint"
                        android:imeOptions="actionNext"
                        android:includeFontPadding="true"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:paddingTop="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="0dp"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_text_primary"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/password_input"
                    style="@style/Widget.Material3.TextInputLayout.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="@color/auth_field_background"
                    app:boxCornerRadiusBottomEnd="@dimen/auth_field_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/auth_field_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/auth_field_corner_radius"
                    app:boxCornerRadiusTopStart="@dimen/auth_field_corner_radius"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:endIconMinSize="36dp"
                    app:endIconMode="password_toggle"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconMinSize="36dp"
                    app:startIconTint="@color/auth_text_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/auth_field_height"
                        android:fontFamily="serif"
                        android:gravity="center_vertical"
                        android:hint="@string/login_password_hint"
                        android:imeOptions="actionDone"
                        android:includeFontPadding="true"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:paddingTop="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:paddingBottom="0dp"
                        android:textColor="@color/auth_text_primary"
                        android:textColorHint="@color/auth_text_primary"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/login_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="serif"
                    android:textColor="@color/auth_error"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/login_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_login_button"
                        android:backgroundTint="@null"
                        android:fontFamily="serif"
                        android:text="@string/login_button"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="15sp" />

                    <ProgressBar
                        android:id="@+id/login_progress"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@android:color/white"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/auth_divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:fontFamily="serif"
                        android:text="@string/login_or"
                        android:textColor="@color/auth_text_secondary"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/auth_divider" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/auth_social_button_size"
                        android:layout_height="@dimen/auth_social_button_size"
                        android:background="@drawable/bg_social_circle"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_google" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="@dimen/auth_social_button_size"
                        android:layout_height="@dimen/auth_social_button_size"
                        android:layout_marginStart="32dp"
                        android:background="@drawable/bg_social_circle"
                        android:clickable="false"
                        android:focusable="false"
                        android:importantForAccessibility="no">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_facebook" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:maxLines="1"
                        android:text="@string/login_no_account"
                        android:textColor="@color/auth_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/register_link"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/login_register_link"
                        android:textColor="@color/auth_accent"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
