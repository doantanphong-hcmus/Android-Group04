<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    tools:ignore="Overdraw">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/community_post_avatar"
            android:layout_width="@dimen/community_avatar_size"
            android:layout_height="@dimen/community_avatar_size"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_TangKinhCac_Circle"
            app:strokeColor="@color/community_avatar_border"
            app:strokeWidth="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/community_post_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/community_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="7dp"
                android:text="@string/community_separator"
                android:textColor="@color/community_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/community_post_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textColor="@color/community_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/community_more_content_description"
            android:padding="9dp"
            android:src="@drawable/ic_community_more" />
    </LinearLayout>

    <TextView
        android:id="@+id/community_post_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="58dp"
        android:fontFamily="serif"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/community_text_primary"
        android:textSize="15sp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/community_post_image"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginStart="58dp"
        android:layout_marginTop="10dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_TangKinhCac_Rounded" />

    <LinearLayout
        android:id="@+id/community_post_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="58dp"
        android:layout_marginTop="9dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/community_post_book_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_community_tag"
            android:fontFamily="serif"
            android:textColor="@color/community_text_primary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/community_post_request_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_community_tag"
            android:fontFamily="serif"
            android:textColor="@color/community_text_primary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/community_post_like_count"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:drawablePadding="8dp"
            android:fontFamily="serif"
            android:gravity="center_vertical"
            android:textColor="@color/community_text_primary"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/ic_community_like" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/community_post_comment_count"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:drawablePadding="8dp"
            android:fontFamily="serif"
            android:gravity="center_vertical"
            android:textColor="@color/community_text_primary"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/ic_community_comment" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/community_post_repost_count"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawablePadding="8dp"
            android:fontFamily="serif"
            android:gravity="center_vertical"
            android:textColor="@color/community_text_primary"
            android:textSize="13sp"
            app:drawableStartCompat="@drawable/ic_community_repost" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_community_bookmark" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/community_border" />
</LinearLayout>
