<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_library_genre_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <com.tangkinhcac.app.ui.CategoryIconView
        android:id="@+id/genre_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:categoryIconIndex="0" />

    <TextView
        android:id="@+id/genre_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:fontFamily="serif"
        android:textColor="@color/library_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="@string/library_symbol_next"
        android:textColor="@color/library_text_primary"
        android:textSize="28sp" />
</LinearLayout>
