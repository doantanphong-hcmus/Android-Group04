<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Room contains rebuildable cache data whose cloud source of truth is Firestore. -->
        <exclude
            domain="database"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="." />
    </device-transfer>
</data-extraction-rules>
