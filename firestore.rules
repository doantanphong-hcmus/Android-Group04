rules_version = '2';

service cloud.firestore {
    match /databases/{database}/documents {

        match /books/{bookId} {
            allow read: if resource.data.status == "published";
            allow write: if false;
        }

        match /users/{userId} {
            allow read: if request.auth != null && request.auth.uid == userId;
            allow create: if isValidNewUser(userId);
            allow update, delete: if false;
        }

        match /usernames/{normalizedUsername} {
            allow get: if request.auth != null;
            allow list: if false;
            allow create: if isValidUsernameReservation(normalizedUsername);
            allow update, delete: if false;
        }

        match /{document=**} {
            allow read, write: if false;
        }

        function isValidNewUser(userId) {
            return request.auth != null
                && request.auth.uid == userId
                && request.resource.data.keys().hasOnly([
                    "fullName",
                    "username",
                    "usernameNormalized",
                    "birthDate",
                    "phoneNumber",
                    "email",
                    "provider",
                    "createdAt"
                ])
                && request.resource.data.fullName is string
                && request.resource.data.fullName.size() >= 2
                && request.resource.data.username is string
                && request.resource.data.username.size() >= 4
                && request.resource.data.username.size() <= 20
                && request.resource.data.usernameNormalized is string
                && request.resource.data.usernameNormalized.matches('^[a-z0-9._]{4,20}$')
                && request.resource.data.birthDate is string
                && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                && request.resource.data.phoneNumber is string
                && request.resource.data.phoneNumber.matches('^[+]?[0-9]{9,15}$')
                && request.resource.data.email == request.auth.token.email
                && request.resource.data.provider == "password"
                && request.resource.data.createdAt == request.time
                && getAfter(
                    /databases/$(database)/documents/usernames/$(request.resource.data.usernameNormalized)
                ).data.uid == userId;
        }

        function isValidUsernameReservation(normalizedUsername) {
            return request.auth != null
                && request.resource.data.keys().hasOnly(["uid"])
                && request.resource.data.uid == request.auth.uid
                && !exists(/databases/$(database)/documents/usernames/$(normalizedUsername))
                && getAfter(
                    /databases/$(database)/documents/users/$(request.auth.uid)
                ).data.usernameNormalized == normalizedUsername;
        }
    }
}
